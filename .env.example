# Copy to .env and fill in. Never commit .env (see .gitignore).
# Every variable is declared and validated in src/config/env.schema.ts.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# CRM-Database, shared with ko-sales and every other portal. Ask the TL for the
# beta URI; never point a local run at production.
MONGODB_URI=
MONGODB_DB_NAME=CRM-Database

# Comma-separated browser origins (HO portal hosts). Empty = none, * = any.
CORS_ORIGINS=

LOG_LEVEL=info
SWAGGER_ENABLED=true

# B2B Sales marketplace API — the catalogue the cart is priced from.
# No token here: B2B tokens belong to signed-in agents and expire, so each
# cart request carries the agent's own (Authorization: Bearer …).
B2B_API_URL=https://api.b2bsales.ko-tech.in/api/v1
B2B_MARKETPLACE_CODE=MKTP-1
CATALOG_CACHE_TTL_SECONDS=60

# TEMPORARY until the login module: read the partner from the x-partner-id
# header. Anyone can act as any partner — never true with real partners' data.
TRUST_PARTNER_HEADER=true
